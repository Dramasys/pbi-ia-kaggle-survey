		  Source = Csv.Document(File.Contents(pDossierData & "kaggle_survey_2021_responses.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
		  Entetes = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
		  SansLibelles = Table.Skip(Entetes, 1),
		  Idx = Table.AddIndexColumn(SansLibelles, "Idx", 1, 1, Int64.Type),
		  Annee = Table.AddColumn(Idx, "Annee", each 2021, Int64.Type),
		  RepID = Table.AddColumn(Annee, "RepondantID", each [Annee] * 1000000 + [Idx], Int64.Type)
		in
		  RepID
	lineageTag: caa25e71-374a-423a-8be9-50def434a485
