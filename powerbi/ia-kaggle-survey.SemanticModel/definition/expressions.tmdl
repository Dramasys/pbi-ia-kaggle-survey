/// Paramètre du dossier référence
expression pDossierRef = "D:\PROJET\pbi-ia-kaggle-survey\data\reference\" meta [IsParameterQuery=true, Type="Text", IsParameterQueryRequired=true]
	lineageTag: 487f9195-3887-437a-b9ce-475380c8f7cb
	queryGroup: 00_Parametres

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Text

expression Mapping_Colonnes =
		let
		    Source = Csv.Document(File.Contents(pDossierRef & "mapping_colonnes.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
		    Entetes = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
		    Types = Table.TransformColumnTypes(Entetes, {{"Annee", Int64.Type}, {"ColonneSource", type text}, {"ColonneCommune", type text}})
		in
		    Types
	lineageTag: 1ef3f52e-b66b-4564-9efb-ebe71acd27ec
	queryGroup: 01_Sources

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

expression Mapping_Themes =
		let
		    Source = Csv.Document(File.Contents(pDossierRef & "mapping_themes.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
		    Entetes = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
		    Types = Table.TransformColumnTypes(Entetes, {{"Annee", Int64.Type}, {"Theme", type text}, {"Prefixe", type text}, {"LibelleQuestion", type text}})
		in
		    Types
	lineageTag: e3d9785c-dcac-4c1d-8591-5a372d18b358
	queryGroup: 01_Sources

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

expression pDossierData = "D:\PROJET\pbi-ia-kaggle-survey\data\raw\" meta [IsParameterQuery=true, Type="Text", IsParameterQueryRequired=true]
	lineageTag: 5f30f0b5-682c-4993-b595-c7d0af699ae6
	queryGroup: 00_Parametres

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Text

expression Src_2022 =
		let
		  Source = Csv.Document(File.Contents(pDossierData & "kaggle_survey_2022_responses.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
		  Entetes = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
		  SansLibelles = Table.Skip(Entetes, 1),
		  Idx = Table.AddIndexColumn(SansLibelles, "Idx", 1, 1, Int64.Type),
		  Annee = Table.AddColumn(Idx, "Annee", each 2022, Int64.Type),
		  RepID = Table.AddColumn(Annee, "RepondantID", each [Annee] * 1000000 + [Idx], Int64.Type)
		in
		  RepID
	lineageTag: 28b0d59c-a435-42f8-9c34-b403cd762ad7
	queryGroup: 01_Sources

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

expression Src_2021 =
		let
		  Source = Csv.Document(File.Contents(pDossierData & "kaggle_survey_2021_responses.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
		  Entetes = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
		  SansLibelles = Table.Skip(Entetes, 1),
		  Idx = Table.AddIndexColumn(SansLibelles, "Idx", 1, 1, Int64.Type),
		  Annee = Table.AddColumn(Idx, "Annee", each 2021, Int64.Type),
		  RepID = Table.AddColumn(Annee, "RepondantID", each [Annee] * 1000000 + [Idx], Int64.Type)
		in
		  RepID
	lineageTag: caa25e71-374a-423a-8be9-50def434a485
	queryGroup: 01_Sources

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

expression Src_2020 =
		let
		  Source = Csv.Document(File.Contents(pDossierData & "kaggle_survey_2020_responses.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
		  Entetes = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
		  SansLibelles = Table.Skip(Entetes, 1),
		  Idx = Table.AddIndexColumn(SansLibelles, "Idx", 1, 1, Int64.Type),
		  Annee = Table.AddColumn(Idx, "Annee", each 2020, Int64.Type),
		  RepID = Table.AddColumn(Annee, "RepondantID", each [Annee] * 1000000 + [Idx], Int64.Type)
		in
		  RepID
	lineageTag: d4c042ba-4047-4703-a1e9-0dfc73bc72c4
	queryGroup: 01_Sources

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

expression fnRenommer =
		(src as table, annee as number) as table =>
		let
		  map = Table.SelectRows(Mapping_Colonnes, each [Annee] = annee),
		  paires = List.Zip({map[ColonneSource], map[ColonneCommune]}),
		  resultat = Table.RenameColumns(src, paires, MissingField.Ignore)
		in
		  resultat
	lineageTag: 70f7485e-d127-4823-8077-003b617f75c5
	queryGroup: 00_Parametres

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Function

expression fnProfil =
		(src as table, annee as number) as table =>
		let
		  Renomme = fnRenommer(src, annee),
		  AvecSecteur = if List.Contains(Table.ColumnNames(Renomme), "Secteur")
		                then Renomme
		                else Table.AddColumn(Renomme, "Secteur", each "Non posée", type text),
		  Garder = Table.SelectColumns(AvecSecteur, {"RepondantID", "Annee", "Age", "Genre", "Pays", "Etudes", "Metier", "ExperienceCodage", "ExperienceML", "Secteur", "Salaire"})
		in
		  Garder
	lineageTag: 37e83eda-2885-4383-94e6-57c5d1f9e0bc
	queryGroup: 00_Parametres

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Function

expression Profil_Tous =
		let
		  Tout = Table.Combine({fnProfil(Src_2020, 2020), fnProfil(Src_2021, 2021), fnProfil(Src_2022, 2022)}),
		  Nettoyer = (v as nullable text) as nullable text =>
		    if v = null then null else Text.Replace(Text.Trim(Text.Clean(v)), "’", "'"),
		  Colonnes = {"Age", "Genre", "Pays", "Etudes", "Metier", "ExperienceCodage", "ExperienceML", "Secteur", "Salaire"},
		  Texte = Table.TransformColumns(Tout, List.Transform(Colonnes, each {_, Nettoyer, type text}))
		in
		    Texte
	lineageTag: 2aba131a-9ee6-497d-b36e-89b06be4bb95
	queryGroup: 02_Staging

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

expression fnTheme =
		(src as table, prefixe as text, theme as text) as table =>
		let
		  cols = List.Select(Table.ColumnNames(src), each Text.StartsWith(_, prefixe) and not Text.Contains(_, "TEXT")),
		  garder = Table.SelectColumns(src, {"RepondantID", "Annee"} & cols),
		  unpivot = Table.UnpivotOtherColumns(garder, {"RepondantID", "Annee"}, "Colonne", "Option"),
		  sans_vide = Table.SelectRows(unpivot, each [Option] <> null and Text.Trim([Option]) <> "" and Text.Lower(Text.Trim([Option])) <> "nan"),
		  nettoye = Table.TransformColumns(sans_vide, {{"Option", each Text.Replace(Text.Trim(Text.Clean(_)), "’", "'"), type text}}),
		  avec_theme = Table.AddColumn(nettoye, "Theme", each theme, type text),
		  final = Table.RemoveColumns(avec_theme, {"Colonne"})
		in
		  final
	lineageTag: bdc42500-b145-492f-9219-91bec9c00f39
	queryGroup: 00_Parametres

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Function

expression fnUsage =
		(src as table, annee as number) as table =>
		let
		  themes = Table.SelectRows(Mapping_Themes, each [Annee] = annee),
		  listes = List.Transform(Table.ToRecords(themes), each fnTheme(src, [Prefixe], [Theme])),
		  tout = Table.Combine(listes)
		in
		  tout
	lineageTag: d511773b-4bdf-4b4a-a242-7c9478254f09
	queryGroup: 00_Parametres

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Function

expression Usage_Tous =
		let
		  Tout = Table.Combine({fnUsage(Src_2020, 2020), fnUsage(Src_2021, 2021), fnUsage(Src_2022, 2022)}),
		  Jointure = Table.NestedJoin(Tout, {"Theme", "Option"}, Ref_Options, {"Theme", "OptionSource"}, "Ref", JoinKind.LeftOuter),
		  Etendu = Table.ExpandTableColumn(Jointure, "Ref", {"Option", "EstOutil"}, {"OptionCommune", "EstOutilRef"}),
		  Option2 = Table.AddColumn(Etendu, "OptionFinale", each if [OptionCommune] <> null then [OptionCommune] else [Option], type text),
		  EstOutil = Table.AddColumn(Option2, "EstOutil", each if [EstOutilRef] <> null then [EstOutilRef] else "Oui", type text),
		  Colonnes = Table.SelectColumns(EstOutil, {"RepondantID", "Annee", "Theme", "OptionFinale", "EstOutil"}),
		  Renomme = Table.RenameColumns(Colonnes, {{"OptionFinale", "Option"}}),
		  Dedoublonne = Table.Distinct(Renomme)
		in
		  Dedoublonne
	lineageTag: 215b5a3a-b64f-4b26-8334-91645fba1142
	queryGroup: 02_Staging

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

expression Ref_Options =
		let
		  Source = Csv.Document(File.Contents(pDossierRef & "harmonisation_options.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
		  Entetes = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
		  Types = Table.TransformColumnTypes(Entetes, {{"Theme", type text}, {"OptionSource", type text}, {"Option", type text}, {"EstOutil", type text}})
		in
		  Types
	lineageTag: 95ff0fd4-0f31-4c07-b4d5-01502ad8c80e
	queryGroup: 01_Sources

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

