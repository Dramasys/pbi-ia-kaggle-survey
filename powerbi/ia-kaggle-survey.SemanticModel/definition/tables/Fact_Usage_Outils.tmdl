	partition Fact_Usage_Outils = m
		mode: import
		queryGroup: 04_Faits
		source =
				let
				  U = Usage_Tous,
				  FR = Table.Buffer(Fact_Repondants),
				  DR = Table.Buffer(Dim_Reponse),
				  J1 = Table.NestedJoin(U, {"RepondantID"}, FR, {"RepondantID"}, "F", JoinKind.LeftOuter),
				  E1 = Table.ExpandTableColumn(J1, "F", {"PaysKey", "DemographieKey", "EmploiKey", "ExperienceKey", "SalaireKey"}, {"PaysKey", "DemographieKey", "EmploiKey", "ExperienceKey", "SalaireKey"}),
				  J2 = Table.NestedJoin(E1, {"Theme", "Option"}, DR, {"Theme", "Option"}, "R", JoinKind.LeftOuter),
				  E2 = Table.ExpandTableColumn(J2, "R", {"ReponseKey"}, {"ReponseKey"}),
				  A = Table.AddColumn(E2, "AnneeKey", each [Annee], Int64.Type),
				  Garder = Table.SelectColumns(A, {"RepondantID", "AnneeKey", "PaysKey", "DemographieKey", "EmploiKey", "ExperienceKey", "SalaireKey", "ReponseKey"}),
				  Types = Table.TransformColumnTypes(Garder, {{"RepondantID", Int64.Type}, {"AnneeKey", Int64.Type}, {"PaysKey", Int64.Type}, {"DemographieKey", Int64.Type}, {"EmploiKey", Int64.Type}, {"ExperienceKey", Int64.Type}, {"SalaireKey", Int64.Type}, {"ReponseKey", Int64.Type}})
				in
				  Types

