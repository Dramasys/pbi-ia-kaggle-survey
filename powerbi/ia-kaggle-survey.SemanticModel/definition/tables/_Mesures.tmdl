table _Mesures
	lineageTag: 08574323-7db6-4e0c-bef4-bfe73d6b02b5

	measure 'Nb Repondants' = COUNTROWS ( Fact_Repondants )
		formatString: #,0
		displayFolder: Volumes
		lineageTag: 904d2e0e-5bf4-42d7-8dfd-131d82f665ef

	measure 'Nb Utilisateurs' = DISTINCTCOUNT ( Fact_Usage_Outils[RepondantID] )
		formatString: #,0
		displayFolder: Volumes
		lineageTag: 97e2eb27-244c-4311-a784-19ffb8bcd482

	measure 'Nb Repondants Question' =
			
			// Base valable seulement si un seul thème est sélectionné ; l'outil et l'indicateur EstOutil sont retirés du filtre
			IF (
			    HASONEVALUE ( Dim_Reponse[Theme] ),
			    CALCULATE ( [Nb Utilisateurs], REMOVEFILTERS ( Dim_Reponse[Option], Dim_Reponse[EstOutil] ) )
			)
		formatString: #,0
		displayFolder: Volumes
		lineageTag: 099116fb-1843-44a9-add2-2ed5968f5912

	measure '% Utilisation' = DIVIDE ( [Nb Utilisateurs], [Nb Repondants Question] )
		formatString: 0.0\ %;-0.0\ %;0.0\ %
		displayFolder: Parts
		lineageTag: 3ef7bec7-8718-4f51-accb-19cf5a448682

	measure 'Nb Pays' =
			
			// Pays réels uniquement : on exclut « Autre pays » et « Non communiqué »
			CALCULATE ( DISTINCTCOUNT ( Fact_Repondants[PaysKey] ), Dim_Pays[EstPaysReel] = "Oui" )
		formatString: 0
		displayFolder: Volumes
		lineageTag: 9fc6bccd-a948-4a81-a992-c0d28cc7a7d8

	measure 'Outil N1' =
			
			// Outil le plus utilisé de la sélection, hors « None » et « Other »
			VAR Candidats =
			    FILTER ( ALLSELECTED ( Dim_Reponse[Option], Dim_Reponse[EstOutil] ), Dim_Reponse[EstOutil] = TRUE () )
			VAR Premier = TOPN ( 1, Candidats, [Nb Utilisateurs], DESC )
			RETURN
			    CONCATENATEX ( Premier, Dim_Reponse[Option], ", " )
		displayFolder: Parts
		lineageTag: 8302a884-49cc-4f9c-9e8f-c6a681b1572f

	measure 'Nb Avec Salaire' =
			
			CALCULATE ( [Nb Repondants], Dim_Salaire[Communique] = TRUE () )
		formatString: #,0
		displayFolder: Salaires
		lineageTag: be5d12d5-10c6-4dd5-9534-e237fc3568cc

	measure 'Taux Reponse Salaire' = DIVIDE ( [Nb Avec Salaire], [Nb Repondants] )
		formatString: 0.0\ %;-0.0\ %;0.0\ %
		displayFolder: Salaires
		lineageTag: 30ab9b22-62e8-407d-a922-c7ef59647bf5

	measure 'Salaire Moyen Estime' =
			
			// Les blancs (« Non communiqué ») sont ignorés par AVERAGEX
			AVERAGEX ( Fact_Repondants, RELATED ( Dim_Salaire[MilieuUSD] ) )
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: Salaires
		lineageTag: 733673db-07bc-41af-bc94-127cb0412df0

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Salaire Median Estime' =
			
			// MEDIANX compte les blancs comme 0 : on se limite aux répondants ayant déclaré un salaire
			CALCULATE ( MEDIANX ( Fact_Repondants, RELATED ( Dim_Salaire[MilieuUSD] ) ), Dim_Salaire[Communique] = TRUE () )
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: Salaires
		lineageTag: a06ca0e9-8e8b-4efb-b7cb-cff4e8c6596d

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Salaire Moyen Fiable' =
			
			// Pas de moyenne en dessous de 30 réponses
			IF ( [Nb Avec Salaire] >= 30, [Salaire Moyen Estime] )
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: Salaires
		lineageTag: 595d8170-972b-4d13-bf88-30a82748cde2

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure '% Utilisation A-1' =
			
			// Part de l'édition précédente : année courante moins un, filtre d'année retiré
			VAR AnneeCourante = MAX ( Dim_Annee[Annee] )
			RETURN
			    CALCULATE ( [% Utilisation], REMOVEFILTERS ( Dim_Annee ), Dim_Annee[Annee] = AnneeCourante - 1 )
		formatString: 0.0\ %;-0.0\ %;0.0\ %
		displayFolder: Tendances
		lineageTag: 38ef6999-9e00-4eb8-bfc4-81224a3d27a4

	measure 'Evolution pts' =
			
			// Écart en points de pourcentage ; vide si l'option n'existait pas l'an dernier ou n'existe plus cette année
			VAR Precedent = [% Utilisation A-1]
			RETURN
			    IF ( ISBLANK ( [% Utilisation] ) || ISBLANK ( Precedent ), BLANK (), ( [% Utilisation] - Precedent ) * 100 )
		formatString: +0.0" pts";-0.0" pts";0.0" pts"
		displayFolder: Tendances
		lineageTag: b92c1606-1b66-4fee-b917-5205c656fb11

		annotation PBI_FormatHint = {"isCustom":true}

	measure 'Rang Outil' =
			
			// Vide pour « None », « Other » et pour une option sans utilisateur dans la sélection
			VAR Candidats =
			    FILTER ( ALLSELECTED ( Dim_Reponse[Option], Dim_Reponse[EstOutil] ), Dim_Reponse[EstOutil] = TRUE () )
			RETURN
			    IF (
			        SELECTEDVALUE ( Dim_Reponse[EstOutil] ) = TRUE () && NOT ISBLANK ( [Nb Utilisateurs] ),
			        RANKX ( Candidats, [Nb Utilisateurs], , DESC, Dense )
			    )
		formatString: 0
		displayFolder: Tendances
		lineageTag: 624316a8-0e5a-483c-a7a9-dbc448102705

	measure 'Part du Pays' =
			
			// Poids du pays dans l'ensemble des répondants : le filtre pays est retiré du dénominateur
			DIVIDE ( [Nb Repondants], CALCULATE ( [Nb Repondants], REMOVEFILTERS ( Dim_Pays ) ) )
		formatString: 0.0\ %;-0.0\ %;0.0\ %
		displayFolder: Parts
		lineageTag: c64c25d8-eb73-47fc-a609-9ff779ac3b02

	measure '% Utilisation Monde' =
			
			// Le filtre pays est retiré ; thème, outil et année sont conservés
			CALCULATE ( [% Utilisation], REMOVEFILTERS ( Dim_Pays ) )
		formatString: 0.0\ %;-0.0\ %;0.0\ %
		displayFolder: Parts
		lineageTag: e0cbe969-deb4-4475-bbd4-6152ad0d39dc

	measure 'Ecart vs Monde pts' =
			
			// Vide si la part du pays ou la part mondiale n'existe pas
			VAR Monde = [% Utilisation Monde]
			RETURN
			    IF ( ISBLANK ( [% Utilisation] ) || ISBLANK ( Monde ), BLANK (), ( [% Utilisation] - Monde ) * 100 )
		formatString: +0.0" pts";-0.0" pts";0.0" pts"
		displayFolder: Parts
		lineageTag: 32f787b9-5eee-426d-98f3-2a337e2842d6

		annotation PBI_FormatHint = {"isCustom":true}

	measure '% Experimentes' =
			
			// Le dénominateur exclut « Non répondu »
			DIVIDE (
			    CALCULATE ( [Nb Repondants], Dim_Experience[ExperienceGroupe] = "Plus de 5 ans" ),
			    CALCULATE ( [Nb Repondants], Dim_Experience[ExperienceGroupe] <> "Non répondu" )
			)
		formatString: 0.0\ %;-0.0\ %;0.0\ %
		displayFolder: Parts
		lineageTag: 4bab432c-eba1-42db-b8a8-10a20b8bad64

	measure '% Repondants Salaire' =
			
			// Base : répondants ayant déclaré un salaire (la tranche est retirée du dénominateur)
			DIVIDE (
			    [Nb Repondants],
			    CALCULATE ( [Nb Repondants], REMOVEFILTERS ( Dim_Salaire ), Dim_Salaire[Communique] = TRUE () )
			)
		formatString: 0.0\ %;-0.0\ %;0.0\ %
		displayFolder: Salaires
		lineageTag: a49b021d-0d19-4039-8dd7-cb376eec9905

	measure 'Titre Fiche Pays' =
			
			// Titre dynamique de la page de détail
			"Fiche pays : " & SELECTEDVALUE ( Dim_Pays[Pays], "tous les pays" )
		displayFolder: Fiche pays
		lineageTag: 3c778093-d367-4ad3-8130-d437dd47bed9

	measure 'Nb Repondants Metier' =
			
			// Vide pour « Non renseigné » et « Autre » (ligne du visuel) ; sinon nombre de répondants
			VAR Metier = SELECTEDVALUE ( Dim_Emploi[Metier] )
			RETURN
			    IF ( NOT ( Metier IN { "Non renseigné", "Autre" } ), [Nb Repondants] )
		formatString: #,0
		displayFolder: Fiche pays
		lineageTag: 93620b03-9b9a-4dd8-ad28-b3fb4152df62

	measure 'Titre Infobulle' =
			
			// Titre dynamique de l'info-bulle : outil et édition survolés
			SELECTEDVALUE ( Dim_Reponse[Option], "Outil" ) & " · " & SELECTEDVALUE ( Dim_Annee[Edition], "toutes éditions" )
		displayFolder: Info-bulle
		lineageTag: 9b77e4ff-52c3-403c-a177-c590407925f8

	column Cle
		isHidden
		formatString: 0
		lineageTag: 65b1eae0-811a-4a3d-a8a3-60624a1ac56c
		summarizeBy: none
		isNameInferred
		sourceColumn: [Cle]

		annotation SummarizationSetBy = User

	partition _Mesures = calculated
		mode: import
		source = ROW ( "Cle", 1 )

	annotation PBI_Id = 6ed48c50fe2541a2b377c555a61768ff

