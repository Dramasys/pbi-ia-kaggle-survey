		sourceColumn: SalaireKey

		annotation SummarizationSetBy = Automatic

	partition Fact_Repondants = m
		mode: import
		queryGroup: 04_Faits
		source =
				let
				  P = Profil_Final,
				  Pays = Table.NestedJoin(P, {"Pays_Valeur"}, Dim_Pays, {"Pays"}, "DP", JoinKind.LeftOuter),
				  Pays2 = Table.ExpandTableColumn(Pays, "DP", {"PaysKey"}, {"PaysKey"}),
				  Sal = Table.NestedJoin(Pays2, {"Salaire_Tranche"}, Dim_Salaire, {"Tranche"}, "DS", JoinKind.LeftOuter),
				  Sal2 = Table.ExpandTableColumn(Sal, "DS", {"SalaireKey"}, {"SalaireKey"}),
				  Cles1 = Table.AddColumn(Sal2, "DemographieKey", each [Age_Ordre] * 10000 + [Genre_Ordre] * 100 + [Etudes_Ordre], Int64.Type),
				  Cles2 = Table.AddColumn(Cles1, "EmploiKey", each [Metier_Ordre] * 100 + [Secteur_Ordre], Int64.Type),
				  Cles3 = Table.AddColumn(Cles2, "ExperienceKey", each [ExperienceCodage_Ordre] * 100 + [ExperienceML_Ordre], Int64.Type),
				  Annee2 = Table.AddColumn(Cles3, "AnneeKey", each [Annee], Int64.Type),
				  Garder = Table.SelectColumns(Annee2, {"RepondantID", "AnneeKey", "PaysKey", "DemographieKey", "EmploiKey", "ExperienceKey", "SalaireKey"}),
				  Types = Table.TransformColumnTypes(Garder, {{"RepondantID", Int64.Type}, {"AnneeKey", Int64.Type}, {"PaysKey", Int64.Type}, {"DemographieKey", Int64.Type}, {"EmploiKey", Int64.Type}, {"ExperienceKey", Int64.Type}, {"SalaireKey", Int64.Type}})
				in
				  Types

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

