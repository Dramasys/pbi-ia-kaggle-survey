	partition Dim_Reponse = m
		mode: import
		queryGroup: 03_Dimensions
		source =
				let
				  Src = Table.SelectColumns(Usage_Tous, {"Theme", "Option", "EstOutil"}),
				  Distincts = Table.Distinct(Src),
				  Tri = Table.Sort(Distincts, {{"Theme", Order.Ascending}, {"Option", Order.Ascending}}),
				  Cle = Table.AddIndexColumn(Tri, "ReponseKey", 1, 1, Int64.Type),
