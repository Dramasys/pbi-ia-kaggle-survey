	partition Dim_Experience = m
		mode: import
		queryGroup: 03_Dimensions
		source =
				let
				  Src = Table.SelectColumns(Profil_Final, {"ExperienceCodage_Valeur", "ExperienceCodage_Ordre", "ExperienceCodage_Groupe", "ExperienceML_Valeur", "ExperienceML_Ordre"}),
				  Distincts = Table.Distinct(Src),
				  Renomme = Table.RenameColumns(Distincts, {{"ExperienceCodage_Valeur", "ExperienceCodage"}, {"ExperienceCodage_Ordre", "ExperienceCodageOrdre"}, {"ExperienceCodage_Groupe", "ExperienceGroupe"}, {"ExperienceML_Valeur", "ExperienceML"}, {"ExperienceML_Ordre", "ExperienceMLOrdre"}}),
				  Tri = Table.Sort(Renomme, {{"ExperienceCodageOrdre", Order.Ascending}, {"ExperienceMLOrdre", Order.Ascending}}),
